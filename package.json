{
  "name": "@u3u/prettier-config",
  "version": "5.2.3",
  "description": "🎨 The most perfect Prettier config",
  "keywords": [
    "prettier-config",
    "prettier-preset"
  ],
  "repository": {
    "url": "https://github.com/u3u/prettier-config.git"
  },
  "license": "MIT",
  "author": "u3u <qwq@qwq.cat> (https://github.com/u3u)",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      },
      "require": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && fix-tsup-cjs",
    "format": "prettier --write .",
    "lint": "eslint --fix .",
    "prepare": "pnpm build",
    "test": "vitest"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --concurrent false"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@prettier/plugin-oxc": "^0.2.2",
    "@prettier/plugin-php": "^0.25.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@shufo/prettier-plugin-blade": "^1.16.2",
    "deepmerge": "^4.3.1",
    "local-pkg": "^1.2.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "prettier-plugin-nginx": "^1.0.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-sh": "^0.19.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remeda": "^2.45.0"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@u3u/eslint-config": "^2.15.2",
    "@u3u/prettier-config": "link:",
    "dedent": "^1.7.2",
    "eslint": "^8.57.1",
    "execa": "^10.0.1",
    "fix-tsup-cjs": "^1.2.0",
    "globby": "^16.2.4",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "publishConfig": {
    "access": "public"
  }
}
